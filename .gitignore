# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Large Binary / Database Files (too big for Git) ───────────────────────────
GeoLite2-ASN.mmdb
GeoLite2-City.mmdb
*.mmdb

# ── Trained ML Model Files (regenerate via training scripts) ─────────────────
# Uncomment lines below if you want to EXCLUDE models from the repo.
# training_model/models/lgbm_threat.joblib
# training_model/models/autoencoder.pth
# training_model/models/ae_meta.joblib
baseline_model.pkl
scaler.pkl

# ── Runtime / Log Files ───────────────────────────────────────────────────────
alerts.log
*.log

# ── IPC / Temp Files ─────────────────────────────────────────────────────────
.sim_status.json
.sim_status.json.tmp

# ── Datasets (large CSV files — document instead) ────────────────────────────
datasets/*.csv

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── OS Junk ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Secrets & Keys (never commit!) ───────────────────────────────────────────
*.key
*.pem
*.env
.env
config/secrets*
